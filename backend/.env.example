# Copy to .env — free-tier only, never commit real keys.
USE_FAKE_AI=true
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# BHASHINI_API_KEY=
# BHASHINI_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
# DATABASE_URL=postgresql://notice:notice@localhost:5432/notice
# REDIS_URL=redis://localhost:6379/0
# Reviewer API key for GET /api/v1/review/queue + POST /api/v1/review/{job_id}/resolve
# (sent as X-Reviewer-Key header). Empty = auth disabled (local dev only).
# REVIEWER_API_KEY=change-me-in-production
# WhatsApp channel (Twilio). ALL must be set or the webhook returns 404.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# PUBLIC_BASE_URL=https://your-public-api.example.com
# WHATSAPP_HASH_SALT=change-me-too
# Legal-corpus review gate: unreviewed chunks stay hidden unless true.
# CORPUS_ALLOW_UNREVIEWED=false
# GEMINI_EMBED_MODEL=gemini-embedding-001
